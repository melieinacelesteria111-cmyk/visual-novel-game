# Web Configuration for Browser Play\n# Optimized for mobile web experience\n\n# Disable features that don't work well on web\ndefine config.web = True\n\n# Optimize for mobile\ndefine config.screen_width = 800\ndefine config.screen_height = 600\n\n# Fast transitions for web\ndefine config.transition_duration = 0.3\n\n# Disable fullscreen on web\ndefine config.fullscreen = False\n\n# Enable web saving\ndefine config.web_save = True\n\n# Auto-save configuration\ndefine config.autosave_frequency = 60\ndefine config.autosave_slots = 3\n\n# Performance optimization\ndefine config.mouse = True\ndefine config.show_mouse_cursor = True\n"